<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <!-- Moving Floating Food Icons Background Layer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivFloatFood1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="50dp"
            android:alpha="0.2"
            android:contentDescription="@string/cat_burgers"
            android:src="@drawable/ic_food_burger" />

        <ImageView
            android:id="@+id/ivFloatFood2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="120dp"
            android:layout_marginEnd="28dp"
            android:alpha="0.2"
            android:contentDescription="@string/cat_pizza"
            android:src="@drawable/ic_food_pizza" />

        <ImageView
            android:id="@+id/ivFloatFood3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="140dp"
            android:alpha="0.2"
            android:contentDescription="@string/cat_milk_tea"
            android:src="@drawable/ic_food_drink" />

        <ImageView
            android:id="@+id/ivFloatFood4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="90dp"
            android:alpha="0.2"
            android:contentDescription="@string/cat_snacks"
            android:src="@drawable/ic_food_snack" />

    </FrameLayout>

    <!-- Foreground Content ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCustomerWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_customer"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/eat_today_subtitle"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnAccountProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_yellow_button"
                    android:paddingHorizontal="14dp"
                    android:text="@string/my_account"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLogoutCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/yellow_light"
                    android:paddingHorizontal="12dp"
                    android:text="@string/logout"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Modern Daily Promos Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_header_gradient"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_yellow"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/hot_promos_badge"
                    android:textColor="@color/text_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/promo_title"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/promo_desc"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Modern Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_input"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/search_hint"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearchFood"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:autofillHints="none"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Food Categories Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/rgCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCatAll"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_badge_yellow"
                        android:button="@null"
                        android:checked="true"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_all"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/rbCatChicken"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_chicken"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbCatCoffee"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_coffee"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbCatDrinks"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_milk_tea"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbCatSnacks"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_snacks"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbCatRice"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_rice"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbCatBurgers"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_burgers"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbCatPizza"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_card"
                        android:button="@null"
                        android:paddingHorizontal="18dp"
                        android:text="@string/cat_pizza"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />
                </RadioGroup>
            </HorizontalScrollView>

            <!-- Sort By Options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_by_label"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSortBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbSortRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/sort_rating"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSortPriceLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/sort_price_low"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbSortFastest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/sort_fastest"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Active Orders Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/active_orders_heading"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llActiveOrdersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Available Meals Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/available_meals_heading"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llFoodItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>