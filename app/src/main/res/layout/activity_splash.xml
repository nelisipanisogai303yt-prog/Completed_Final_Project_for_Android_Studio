<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <!-- Background Sizzling Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_food_background_sizzling"
        android:contentDescription="@null" />

    <!-- Moving Floating Food Icons Background Layer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivFloatFood1"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-25dp"
            android:layout_marginTop="30dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_fast_foods"
            android:src="@drawable/ic_food_fast_food" />

        <ImageView
            android:id="@+id/ivFloatFood2"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="-25dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_rice_meals"
            android:src="@drawable/ic_food_rice_meals" />

        <ImageView
            android:id="@+id/ivFloatFood3"
            android:layout_width="155dp"
            android:layout_height="155dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-25dp"
            android:layout_marginBottom="90dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_beverage"
            android:src="@drawable/ic_food_beverage" />

        <ImageView
            android:id="@+id/ivFloatFood4"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-25dp"
            android:layout_marginBottom="50dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_snacks"
            android:src="@drawable/ic_food_snack" />

    </FrameLayout>

    <!-- Centered Logo & Branding Intro -->
    <LinearLayout
        android:id="@+id/llSplashBranding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="409dp"
            android:layout_height="424dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_bitedash_logo" />

        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/text_dark"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
