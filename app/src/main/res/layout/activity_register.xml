<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <!-- Moving Floating Food Icons Background Layer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivFloatFood1"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_burgers"
            android:src="@drawable/ic_food_burger" />

        <ImageView
            android:id="@+id/ivFloatFood2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="32dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_pizza"
            android:src="@drawable/ic_food_pizza" />

        <ImageView
            android:id="@+id/ivFloatFood3"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="100dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_milk_tea"
            android:src="@drawable/ic_food_drink" />

        <ImageView
            android:id="@+id/ivFloatFood4"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="60dp"
            android:alpha="0.25"
            android:contentDescription="@string/cat_snacks"
            android:src="@drawable/ic_food_snack" />

    </FrameLayout>

    <!-- Foreground Content Layer -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivRegisterLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_bitedash_logo" />

            <TextView
                android:id="@+id/tvRegisterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/join_bitedash"
                android:textColor="@color/text_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRegisterSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/create_account_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Username Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRegUsername"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="@string/choose_username"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <!-- Password Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/password"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="@string/choose_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <!-- Role Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/select_account_role"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- RadioGroup for 2 RadioButtons (Customer / Store Owner) -->
                <RadioGroup
                    android:id="@+id/rgRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbCustomer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/role_customer"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbStoreOwner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/role_owner"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- Register Button -->
                <Button
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_yellow_button"
                    android:text="@string/create_account_button"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="8dp"
                android:text="@string/login_link"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>